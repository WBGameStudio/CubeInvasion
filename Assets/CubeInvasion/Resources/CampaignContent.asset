    kind: 1
    damage: 3.5
    interval: 0.48
    projectileLife: 1
    pellets: 2
    spread: 3
    color: {r: 0.45, g: 0.5, b: 1, a: 1}
  - title: Scatter Shot
    description: "Be\u015F sa\xE7ma, geni\u015F a\xE7\u0131. Yakla\u015F\u0131nca
