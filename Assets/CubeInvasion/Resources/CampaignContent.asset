  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9600e41e942a4dfeb971ee074976ee4, type: 3}
  m_Name: CampaignContent
  m_EditorClassIdentifier: Assembly-CSharp::CubeInvasion.Prototype.P2ContentCatalog
  weapons:
  - title: Pulse Pistol
    description: "Balanced single shot. Reliable at long range."
    model: Pulse pistol
    kind: 0
    damage: 6
    interval: 0.5
    projectileLife: 1
    pellets: 1
    spread: 0
    color: {r: 0.1, g: 0.8, b: 1, a: 1}
  - title: Twin Blasters
    description: "Twin barrels fire together. Heavy damage at mid range."
    model: Twin blasters
    kind: 1
    damage: 3.5
    interval: 0.48
    projectileLife: 1
    pellets: 2
    spread: 3
    color: {r: 0.45, g: 0.5, b: 1, a: 1}
  - title: Scatter Shot
    description: "Five pellets, wide spread. Deadly up close on one target."
    model: Scatter shot
    kind: 2
    damage: 3
    interval: 0.9
    projectileLife: 0.32
    pellets: 5
    spread: 28
    color: {r: 1, g: 0.63, b: 0.18, a: 1}
  - title: Rapid SMG
    description: "Small rounds, high fire rate. Keep moving, keep the pressure."
    model: Rapid smg
    kind: 3
    damage: 2
    interval: 0.14
    projectileLife: 1
    pellets: 1
    spread: 0
    color: {r: 0.25, g: 1, b: 0.62, a: 1}
  - title: Pierce Rifle
    description: "Pierces lined-up targets; beats front shields."
    model: Expansion PierceRifle
    kind: 4
    damage: 12
    interval: 1
    projectileLife: 1
    pellets: 1
    spread: 0
    color: {r: 0.1, g: 0.8, b: 0.85, a: 1}
  - title: Ricochet Gun
    description: "Bounces to two more targets; cover cuts the link."
    model: Expansion RicochetGun
    kind: 5
    damage: 8
    interval: 0.8
    projectileLife: 1
    pellets: 1
    spread: 0
    color: {r: 1, g: 0.58, b: 0.2, a: 1}
  - title: Arc Launcher
    description: "Chain lightning to three nearby targets."
    model: Expansion ArcLauncher
    kind: 6
    damage: 7
    interval: 0.65
    projectileLife: 1
    pellets: 1
    spread: 0
    color: {r: 0.5, g: 0.4, b: 1, a: 1}
  - title: Rocket Pod
