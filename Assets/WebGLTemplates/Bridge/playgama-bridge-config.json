{
    "$schema": "https://bridge.playgama.com/v2/stable/schema.json",
    "advertisement": {
        "initialInterstitialDelay": 150,
        "minimumDelayBetweenInterstitial": 150,
        "interstitial": {
            "preloadOnStart": true,
            "placements": [
                {
                    "id": "level_completed"
                },
                {
                    "id": "level_failed"
                },
                {
                    "id": "main_menu"
                }
            ]
        },
        "rewarded": {
            "preloadOnStart": true,
            "placements": [
                {
                    "id": "double_gold"
                },
                {
                    "id": "revive"
                },
                {
                    "id": "weapon_trial"
                }
            ]
        },
        "useBuiltInErrorPopup": true,
        "backfillId": "",
        "banner": {
            "placements": [
                {
                    "id": "menu_banner"
                }
            ]
        }
    },
    "payments": [],
    "leaderboards": [],
    "sendAnalyticsEvents": true
}
